    "synthetic": true,
    "contains_real_patient_data": false,
    "contains_injection_content": false,
    "style": "Synthea-style synthetic laboratory observations (test name + LOINC + numeric value + unit), authored by hand for this evaluation.",
    "independence": "Every expected value in this file was authored independently of the extractor. The report PDFs in synthea_reports/ are RENDERED FROM this file; the evaluator never derives expectations from extractor output, and no expected value was copied from a live or mocked extraction result.",
    "supported_labs_only": "All test names, LOINC codes and units come from data/supported_labs.json (27 supported laboratory tests). No unsupported LOINC mapping is invented; units are units already understood by data/reference_ranges.json and agents/reference_range.py.",
    "deterministic": "The whole evaluation is offline: no OpenRouter/LLM/network access is used. The PDFs are generated deterministically (reportlab invariant mode) from this file by tests/evaluation/generate_synthea_reports.py.",
    "patients": "All patient identities are obvious synthetic placeholders (SYNTHEA-xxx) with synthetic collection dates."
  },
  "metric_definition": {
    "required_fields": ["test_name", "loinc_code", "value", "unit"],
    "field_accuracy": "(# expected observations whose matched extracted observation has that field equal) / (# expected observations). A missing or unexpected observation can never make a field count as correct.",
    "observation_accuracy": "(# expected observations where all four required fields match) / (# expected observations). This is the headline extraction-accuracy metric and the value compared against the target.",
    "extraction_precision": "(# fully correct extracted observations) / (# extracted observations). Reported for visibility; unexpected extra observations lower this value.",
    "test_name_comparison": "case-insensitive, whitespace-collapsed exact string equality",
    "loinc_comparison": "exact string equality after whitespace strip",
    "value_comparison": "numeric (float coercion) with math.isclose(abs_tol=1e-9, rel_tol=0) — 5, 5.0 and 5.00 are equivalent; 13.4 and 13.0 are not",
    "unit_comparison": "exact after case/whitespace/µ-to-u normalization; otherwise the project's existing unit-conversion table (agents/reference_range.py) may classify the pair as EQUIVALENT (reported separately as a unit-equivalence match, still a match). No new or generic medical conversion is introduced.",
    "target": 0.95,
    "pass_rule": "observation_accuracy >= target AND every field accuracy >= target AND unexpected extra observations == 0",
    "matching_strategy": "deterministic, see tests/evaluation/evaluator.py: (1) identity match on (normalized test name, LOINC) followed by occurrence order within each identity group, (2) diagnostic pairing of leftovers by normalized test name, (3) diagnostic pairing of remaining leftovers by LOINC code, (4) remaining expected observations are MISSING and remaining extracted observations are UNEXPECTED."
  },
